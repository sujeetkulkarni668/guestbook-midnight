{
  "name": "@guestbook/contract",
  "version": "1.0.0",
  "private": true,
  "description": "Guestbook Compact Smart Contract",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compact": "compact compile src/guestbook.compact ./src/managed/guestbook",
    "build": "rimraf dist && tsc --project tsconfig.json && cp -Rf ./src/managed ./dist/managed && cp ./src/guestbook.compact ./dist",
    "clean": "rimraf dist",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "deploy:preview": "dotenv -e .env.preview -- tsx deploy/deploy.ts preview",
    "deploy:preprod": "dotenv -e .env.preprod -- tsx deploy/deploy.ts preprod",
    "deploy:mainnet": "dotenv -e .env.mainnet -- tsx deploy/deploy.ts mainnet"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "^3.1.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "^3.1.0",
    "@midnight-ntwrk/wallet": "^5.0.0",
    "@midnight-ntwrk/wallet-api": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
