// Guestbook Smart Contract
// Based on the Midnight example-bboard project.

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  EMPTY,
  SIGNED
}

export ledger state: State;

export ledger guestName: Maybe<Opaque<"string">>;

export ledger guestMessage: Maybe<Opaque<"string">>;

export ledger sequence: Counter;

export ledger owner: Bytes<32>;

export { Maybe };

constructor() {
  state = State.EMPTY;
  guestName = none<Opaque<"string">>();
  guestMessage = none<Opaque<"string">>();
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit signGuestbook(
  name: Opaque<"string">,
  message: Opaque<"string">
): [] {

  assert(state == State.EMPTY, "Guestbook already signed");

  owner = disclose(
    publicKey(localSecretKey(), sequence as Field as Bytes<32>)
  );

  guestName = disclose(
    some<Opaque<"string">>(name)
  );

  guestMessage = disclose(
    some<Opaque<"string">>(message)
  );

  state = State.SIGNED;
}

export circuit clearGuestbook(): [] {

  assert(state == State.SIGNED, "Guestbook is already empty");

  assert(
    owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>),
    "Only the signer can clear the guestbook"
  );

  guestName = none<Opaque<"string">>();
  guestMessage = none<Opaque<"string">>();

  state = State.EMPTY;

  sequence.increment(1);
}

export circuit publicKey(
  sk: Bytes<32>,
  sequence: Bytes<32>
): Bytes<32> {

  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "guestbook:pk:"),
    sequence,
    sk
  ]);
}